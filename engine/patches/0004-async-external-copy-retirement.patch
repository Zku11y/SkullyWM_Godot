+uint64_t RenderingDevice::texture_external_snapshot_submit(uint64_t p_image, uint64_t p_memory, uint32_t p_width, uint32_t p_height) {
+	ERR_RENDER_THREAD_GUARD_V(0);
+	ERR_FAIL_COND_V(external_snapshot_job.ticket || driver->get_api_name() != "Vulkan" || !p_image || !p_memory || !p_width || !p_height || p_width > 2048 || p_height > 2048, 0);
+	TextureFormat format;
+	format.texture_type = TEXTURE_TYPE_2D;
+	format.format = DATA_FORMAT_R8G8B8A8_UNORM;
+	format.width = p_width;
+	format.height = p_height;
+	format.usage_bits = TEXTURE_USAGE_SAMPLING_BIT | TEXTURE_USAGE_CAN_COPY_FROM_BIT | TEXTURE_USAGE_CAN_COPY_TO_BIT;
+	format.shareable_formats.push_back(DATA_FORMAT_R8G8B8A8_UNORM);
+	format.shareable_formats.push_back(DATA_FORMAT_R8G8B8A8_SRGB);
+	RID destination = texture_create(format, TextureView());
+	ERR_FAIL_COND_V(!destination.is_valid(), 0);
+	Texture *texture = texture_owner.get_or_null(destination);
+	if (!driver->texture_external_snapshot_submit(p_image, p_memory, texture->driver_id, main_queue, p_width, p_height)) {
+		free_rid(destination);
+		return 0;
+	}
+	external_snapshot_job.ticket = ++external_snapshot_sequence;
+	external_snapshot_job.texture = destination;
+	return external_snapshot_job.ticket;
+}
+
+Dictionary RenderingDevice::_external_snapshot_poll(bool p_wait) {
+	Dictionary result;
+	int release_fd = -1;
+	Error error = driver->texture_external_snapshot_poll(p_wait, !external_snapshot_job.discarded, release_fd);
+	if (error == ERR_BUSY) {
+		result["pending"] = true;
+		return result;
+	}
+	RID destination = external_snapshot_job.texture;
+	if (error != OK || external_snapshot_job.discarded) {
+		free_rid(destination);
+		result["error"] = external_snapshot_job.discarded ? "Cancelled" : "External copy failed";
+	} else {
+		Texture *texture = texture_owner.get_or_null(destination);
+		texture->has_initial_data = true;
+		texture->pending_clear = false;
+		texture->draw_tracker->usage = RDG::RESOURCE_USAGE_TEXTURE_SAMPLE;
+		texture->draw_tracker->usage_access = RDD::BARRIER_ACCESS_SHADER_READ_BIT;
+		texture->draw_tracker->current_frame_stages = RDD::PIPELINE_STAGE_ALL_COMMANDS_BIT;
+		result["texture_rd_rid"] = destination;
+		result["release_fd"] = release_fd; // owned FD, or -1 for already-signalled
+	}
+	external_snapshot_job = ExternalSnapshotJob();
+	return result;
+}
+
+Dictionary RenderingDevice::texture_external_snapshot_poll(uint64_t p_ticket) {
+	ERR_RENDER_THREAD_GUARD_V(Dictionary());
+	Dictionary error;
+	if (!p_ticket || p_ticket != external_snapshot_job.ticket || external_snapshot_job.discarded) {
+		error["error"] = "Unknown or discarded copy ticket";
+		return error;
+	}
+	return _external_snapshot_poll(false);
+}
+
+void RenderingDevice::texture_external_snapshot_discard(uint64_t p_ticket) {
+	ERR_RENDER_THREAD_GUARD();
+	if (p_ticket && p_ticket == external_snapshot_job.ticket) {
+		external_snapshot_job.discarded = true;
+		_external_snapshot_poll(false);
+	}
+}
+
+uint32_t RenderingDevice::texture_external_snapshot_pending_count() {
+	ERR_RENDER_THREAD_GUARD_V(0);
+	if (external_snapshot_job.ticket && external_snapshot_job.discarded) {
+		_external_snapshot_poll(false);
+	}
+	return external_snapshot_job.ticket ? 1 : 0;
+}
