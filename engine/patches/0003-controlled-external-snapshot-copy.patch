+Error RenderingDeviceDriverVulkan::texture_copy_external_snapshot(uint64_t p_source, TextureID p_destination, CommandQueueID p_queue, uint32_t p_width, uint32_t p_height) {
+	// Deliberately synchronous diagnostic. The caller owns a producer-complete
+	// imported source. A successful return is GPU completion, not submission.
+	CommandQueue *queue_info = (CommandQueue *)p_queue.id;
+	Queue &queue = queue_families[queue_info->queue_family][queue_info->queue_index];
+	const TextureInfo *destination = (const TextureInfo *)p_destination.id;
+	VkImage source = (VkImage)p_source;
+	VkCommandPool pool = VK_NULL_HANDLE;
+	VkFence fence = VK_NULL_HANDLE;
+	VkResult result = VK_SUCCESS;
+	do {
+		VkCommandPoolCreateInfo pool_info = {};
+		pool_info.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
+		pool_info.queueFamilyIndex = queue_info->queue_family;
+		result = vkCreateCommandPool(vk_device, &pool_info, nullptr, &pool);
+		if (result != VK_SUCCESS) { break; }
+		VkCommandBufferAllocateInfo allocate = {};
+		allocate.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
+		allocate.commandPool = pool;
+		allocate.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+		allocate.commandBufferCount = 1;
+		VkCommandBuffer command;
+		result = vkAllocateCommandBuffers(vk_device, &allocate, &command);
+		if (result != VK_SUCCESS) { break; }
+		VkCommandBufferBeginInfo begin = {};
+		begin.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+		begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+		result = vkBeginCommandBuffer(command, &begin);
+		if (result != VK_SUCCESS) { break; }
+		VkImageMemoryBarrier barriers[2] = {};
+		for (VkImageMemoryBarrier &barrier : barriers) {
+			barrier.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+			barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+			barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+			barrier.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+		}
+		barriers[0].image = source;
+		barriers[0].oldLayout = VK_IMAGE_LAYOUT_GENERAL;
+		barriers[0].newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+		barriers[0].srcQueueFamilyIndex = VK_QUEUE_FAMILY_EXTERNAL;
+		barriers[0].dstQueueFamilyIndex = queue_info->queue_family;
+		barriers[0].dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+		barriers[1].image = destination->vk_view_create_info.image;
+		barriers[1].oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+		barriers[1].newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+		barriers[1].dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+		vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 2, barriers);
+		VkImageCopy copy = {};
+		copy.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		copy.dstSubresource = copy.srcSubresource;
+		copy.extent = { p_width, p_height, 1 };
+		vkCmdCopyImage(command, source, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, destination->vk_view_create_info.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+		barriers[0].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+		barriers[0].newLayout = VK_IMAGE_LAYOUT_GENERAL;
+		barriers[0].srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+		barriers[0].dstAccessMask = 0;
+		barriers[0].srcQueueFamilyIndex = queue_info->queue_family;
+		barriers[0].dstQueueFamilyIndex = VK_QUEUE_FAMILY_EXTERNAL;
+		barriers[1].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+		barriers[1].newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+		barriers[1].srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+		barriers[1].dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+		vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr, 2, barriers);
+		result = vkEndCommandBuffer(command);
+		if (result != VK_SUCCESS) { break; }
+		VkFenceCreateInfo fence_info = {};
+		fence_info.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+		result = vkCreateFence(vk_device, &fence_info, nullptr, &fence);
+		if (result != VK_SUCCESS) { break; }
+		VkSubmitInfo submit = {};
+		submit.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+		submit.commandBufferCount = 1;
+		submit.pCommandBuffers = &command;
+		queue.submit_mutex.lock();
+		result = vkQueueSubmit(queue.queue, 1, &submit, fence);
+		queue.submit_mutex.unlock();
+		if (result != VK_SUCCESS) { break; }
+		// No peer-controlled semaphore waits are submitted in this proof. Do not
+		// free in-flight resources on a timeout. Production needs async retirement.
+		result = vkWaitForFences(vk_device, 1, &fence, VK_TRUE, UINT64_MAX);
+	} while (false);
+	if (fence != VK_NULL_HANDLE) { vkDestroyFence(vk_device, fence, nullptr); }
+	if (pool != VK_NULL_HANDLE) { vkDestroyCommandPool(vk_device, pool, nullptr); }
+	ERR_FAIL_COND_V_MSG(result != VK_SUCCESS, FAILED, vformat("External snapshot copy failed (VkResult %d).", result));
+	return OK;
+}
