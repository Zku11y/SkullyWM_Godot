+RID RenderingDevice::texture_create_from_external_snapshot(uint64_t p_image, uint32_t p_width, uint32_t p_height) {
+	ERR_RENDER_THREAD_GUARD_V(RID());
+	ERR_FAIL_COND_V(driver->get_api_name() != "Vulkan" || !p_image || !p_width || !p_height || p_width > 2048 || p_height > 2048, RID());
+	TextureFormat format;
+	format.texture_type = TEXTURE_TYPE_2D;
+	format.format = DATA_FORMAT_R8G8B8A8_UNORM;
+	format.width = p_width;
+	format.height = p_height;
+	format.depth = 1;
+	format.array_layers = 1;
+	format.mipmaps = 1;
+	format.usage_bits = TEXTURE_USAGE_SAMPLING_BIT | TEXTURE_USAGE_CAN_COPY_FROM_BIT | TEXTURE_USAGE_CAN_COPY_TO_BIT;
+	format.shareable_formats.push_back(DATA_FORMAT_R8G8B8A8_UNORM);
+	format.shareable_formats.push_back(DATA_FORMAT_R8G8B8A8_SRGB);
+	RID result = texture_create(format, TextureView());
+	ERR_FAIL_COND_V(!result.is_valid(), RID());
+	Texture *texture = texture_owner.get_or_null(result);
+	Error error = driver->texture_copy_external_snapshot(p_image, texture->driver_id, main_queue, p_width, p_height);
+	if (error != OK) {
+		free_rid(result);
+		return RID();
+	}
+	// No graph command has seen this newly allocated texture. The diagnostic
+	// submission completed and left it shader-readable; never discard its data.
+	texture->has_initial_data = true;
+	texture->pending_clear = false;
+	texture->draw_tracker->usage = RDG::RESOURCE_USAGE_TEXTURE_SAMPLE;
+	texture->draw_tracker->usage_access = RDD::BARRIER_ACCESS_SHADER_READ_BIT;
+	texture->draw_tracker->current_frame_stages = RDD::PIPELINE_STAGE_ALL_COMMANDS_BIT;
+	return result;
+}
